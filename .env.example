APP_NAME="LinkPlease Webhook Service"
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://linkplease:linkplease@localhost:5432/linkplease
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
PSEUDOGRAM_API_KEY=replace-with-api-key
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
VERIFY_WEBHOOK_SIGNATURES=true
PSEUDOGRAM_SEND_RATE_LIMIT=10
PSEUDOGRAM_SEND_RATE_WINDOW_SECONDS=60
DM_MAX_ATTEMPTS=5
DM_SENDING_STALE_SECONDS=300
DM_MAX_DELIVERY_ATTEMPTS=3
DM_RECONCILE_DELAY_SECONDS=30
DM_RECONCILING_STALE_SECONDS=300
